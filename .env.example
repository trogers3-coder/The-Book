# --- App access ---
# The single password used to sign in to the app (it's a personal archive,
# not a multi-user product). Pick something long and random.
APP_PASSWORD=
# Random 32+ char secret used to sign the login session cookie.
# Generate with: openssl rand -base64 32
APP_SESSION_SECRET=
# Random secret used to encrypt Gmail OAuth tokens at rest in Supabase.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Supabase (project mfazietajkocomqkjzsg) ---
SUPABASE_URL=https://mfazietajkocomqkjzsg.supabase.co
# Service role key - server-only, never expose to the browser.
# Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Gmail read-only) ---
# See SETUP.md for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI configured on the OAuth client.
# Local dev: http://localhost:3000/api/auth/google/callback
# Production: https://<your-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Claude API (call sheet extraction) ---
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5.
# CLAUDE_EXTRACTION_MODEL=claude-opus-5

# --- Scheduled sync ---
# Shared secret for the cron-triggered /api/cron/sync endpoint.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Optional tuning (all have sensible defaults, uncomment to override) ---
# Gmail search query used to find candidate call sheet emails.
# GMAIL_QUERY=(subject:"call sheet" OR "call sheet" OR "rate confirmation" OR "booking confirmation" OR filename:pdf) -category:promotions -category:social
# How far back to look on an account's very first sync.
# GMAIL_SYNC_LOOKBACK_DAYS=3650
# Overlap window (days) re-scanned on each incremental sync, to catch late-arriving mail.
# GMAIL_SYNC_OVERLAP_DAYS=2
# Max new messages processed per sync invocation (keeps each request within time limits).
# SYNC_MESSAGE_LIMIT=25
# Minimum extraction confidence (0-1) to save a result as a call sheet.
# CALL_SHEET_CONFIDENCE_THRESHOLD=0.5
